#!/bin/sh
# prompt-nvim: open the current AI-tool prompt in Neovim.
# Used as the external editor ($VISUAL/$EDITOR) by terminal AI coding tools.

set -eu

VERSION="0.4.0"

target="${PROMPT_NVIM_TARGET:-}"
bridge="${PROMPT_NVIM_BRIDGE:-1}"
nvim_cmd="${PROMPT_NVIM_EXECUTABLE:-nvim}"
server="${PROMPT_NVIM_SERVER:-}"

# Targets that get a shell wrapper, in printed order. A wrapper only selects
# PROMPT_NVIM_TARGET, so this mirrors the plugin's built-in targets and needs
# no other coordination with the Lua side.
SHELL_TARGETS="claude codex gemini opencode pi omp"

usage() {
    cat <<'EOF'
prompt-nvim: Open the current AI-tool prompt in Neovim.

Usage: prompt-nvim [options] [--] <file> [args...]

Options:
  --target <name>        Select AI-tool target
  --target=<name>        Select AI-tool target
  --nvim <command>       Neovim executable to use (default: nvim)
  --server <address>     Open through an existing Neovim server (--remote-wait)
  --no-bridge            Disable bridge behavior
  --print-shell <shell>  Print shell integration (bash|zsh|fish|nu|nushell)
  --check                Validate the installation
  --help, -h             Show this help
  --version              Show version
EOF
}

# The snippets are generated here rather than read from a `shell/` directory
# beside the script. Every documented install copies this single file onto
# PATH, where no such directory exists, so a repo-relative lookup only ever
# worked when running straight from a checkout.
print_shell() {
    _shell="$1"
    case "$_shell" in
        bash | zsh)
            printf '%s\n' \
                "# prompt.nvim $VERSION shell integration (bash/zsh)." \
                "# Add to your shell rc:  eval \"\$(prompt-nvim --print-shell $_shell)\"" \
                "# Each function launches the AI tool with prompt-nvim as its external editor."
            for _t in $SHELL_TARGETS; do
                cat <<EOF

$_t() {
  PROMPT_NVIM_TARGET=$_t \\
  VISUAL=prompt-nvim \\
  EDITOR=prompt-nvim \\
  command $_t "\$@"
}
EOF
            done
            ;;
        fish)
            printf '%s\n' \
                "# prompt.nvim $VERSION shell integration (fish)." \
                "# Add to your config:  prompt-nvim --print-shell fish | source" \
                "# Each function launches the AI tool with prompt-nvim as its external editor."
            for _t in $SHELL_TARGETS; do
                cat <<EOF

function $_t
    env PROMPT_NVIM_TARGET=$_t VISUAL=prompt-nvim EDITOR=prompt-nvim command $_t \$argv
end
EOF
            done
            ;;
        nu | nushell)
            printf '%s\n' \
                "# prompt.nvim $VERSION shell integration (nushell)." \
                "# Add to your config, or:  prompt-nvim --print-shell nu | save -f ~/.config/nushell/prompt-nvim.nu" \
                "# Shape targets nushell 0.90+; older/newer versions may need adjustment." \
                "# Each command launches the AI tool with prompt-nvim as its external editor."
            for _t in $SHELL_TARGETS; do
                cat <<EOF

def --wrapped $_t [...args] {
    with-env {PROMPT_NVIM_TARGET: $_t, VISUAL: prompt-nvim, EDITOR: prompt-nvim} {
        ^$_t ...\$args
    }
}
EOF
            done
            ;;
        *)
            printf '%s\n' "prompt-nvim: unknown shell: $_shell" >&2
            exit 2
            ;;
    esac
}

# Ask nvim what it knows about the plugin. Emits a single parseable line:
#   PROMPT_CHECK <plugin-version|-> <resolved-target|nil>
# Kept to one -c expression because the launcher is installed as a lone file
# and cannot ship a companion Lua script.
NVIM_PROBE='lua local ok,v=pcall(function() return require("prompt.version").version end)
local t=nil
local okm,m=pcall(require,"prompt.target")
if okm then local okr,r=pcall(m.resolve,0) if okr then t=r end end
io.stdout:write("PROMPT_CHECK "..(ok and v or "-").." "..tostring(t).."\n")'

# `timeout` is coreutils and is absent on a stock macOS, so it is used only
# when present: a bounded probe where possible, an unbounded one otherwise,
# rather than failing outright on a missing tool.
run_probe() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 30 "$nvim_cmd" --headless -c "$NVIM_PROBE" -c 'qa!' 2>/dev/null || true
    else
        "$nvim_cmd" --headless -c "$NVIM_PROBE" -c 'qa!' 2>/dev/null || true
    fi
}

check() {
    _resolved=$(command -v "$nvim_cmd" 2>/dev/null || true)
    if [ -z "$_resolved" ]; then
        printf '%s\n' "prompt-nvim: nvim not found: $nvim_cmd" >&2
        return 1
    fi
    printf '%s\n' "prompt-nvim: nvim found: $_resolved"
    printf '%s\n' "prompt-nvim: launcher version $VERSION"

    # Resolving nvim proves nothing about the plugin: the launcher reported OK
    # on a machine where prompt.nvim was never installed. Drive nvim once and
    # check the pieces that actually have to line up.
    _probe=$(run_probe | sed -n 's/^PROMPT_CHECK //p' | head -n 1)
    if [ -z "$_probe" ]; then
        printf '%s\n' "prompt-nvim: could not query nvim (it did not start, or exited early)" >&2
        return 1
    fi

    _plugin_version=${_probe%% *}
    _target=${_probe#* }

    if [ "$_plugin_version" = "-" ]; then
        printf '%s\n' "prompt-nvim: prompt.nvim is not loadable in nvim - is the plugin installed?" >&2
        return 1
    fi
    printf '%s\n' "prompt-nvim: plugin version $_plugin_version"

    if [ "$_plugin_version" != "$VERSION" ]; then
        printf '%s\n' "prompt-nvim: launcher $VERSION does not match plugin $_plugin_version." \
            "prompt-nvim: re-run the plugin build/install step to refresh $0" >&2
        return 1
    fi

    # Informational: the target normally arrives at runtime from the shell
    # wrapper, so its absence here is expected and must not fail the check.
    if [ "$_target" = "nil" ]; then
        printf '%s\n' "prompt-nvim: no target resolves right now (set PROMPT_NVIM_TARGET, or default_target in setup())"
    else
        printf '%s\n' "prompt-nvim: target resolves to $_target"
    fi

    printf '%s\n' "prompt-nvim: OK"
    return 0
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --target)
            [ "$#" -ge 2 ] || {
                printf '%s\n' "prompt-nvim: --target requires a value" >&2
                exit 2
            }
            target="$2"
            shift 2
            ;;
        --target=*)
            target="${1#--target=}"
            shift
            ;;
        --nvim)
            [ "$#" -ge 2 ] || {
                printf '%s\n' "prompt-nvim: --nvim requires a value" >&2
                exit 2
            }
            nvim_cmd="$2"
            shift 2
            ;;
        --server)
            [ "$#" -ge 2 ] || {
                printf '%s\n' "prompt-nvim: --server requires a value" >&2
                exit 2
            }
            server="$2"
            shift 2
            ;;
        --no-bridge)
            bridge=0
            shift
            ;;
        --print-shell)
            [ "$#" -ge 2 ] || {
                printf '%s\n' "prompt-nvim: --print-shell requires a value" >&2
                exit 2
            }
            print_shell "$2"
            exit 0
            ;;
        --check)
            check
            exit "$?"
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        --version)
            printf '%s\n' "prompt-nvim $VERSION"
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf '%s\n' "prompt-nvim: unknown option: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -gt 0 ] || {
    printf '%s\n' "prompt-nvim: missing prompt file" >&2
    exit 2
}

file="$1"

# The prompt file must be addressed absolutely: in --server mode the server
# opens it relative to ITS cwd, not ours, and the plugin keys the session on
# the normalized absolute path.
case "$file" in
    /*) abs_file="$file" ;;
    *) abs_file="$PWD/$file" ;;
esac

launch_cwd="$PWD"
session_id="${PROMPT_NVIM_SESSION:-p$$-$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || echo "$$")}"

export PROMPT_NVIM_TARGET="$target"
export PROMPT_NVIM_BRIDGE="$bridge"
export PROMPT_NVIM_CWD="$launch_cwd"
export PROMPT_NVIM_SESSION="$session_id"

# Raw-byte backup in a private temp dir. Cancellation restores from this
# (byte for byte); the launcher also restores it if the editor crashes.
backup=""
backup_dir=$(mktemp -d 2>/dev/null || echo "")
if [ -n "$backup_dir" ]; then
    backup="$backup_dir/backup"
    cp -p -- "$abs_file" "$backup" 2>/dev/null || backup=""
fi
export PROMPT_NVIM_BACKUP="$backup"

cleanup() {
    [ -n "$backup_dir" ] && rm -rf -- "$backup_dir" 2>/dev/null || true
}

# JSON string escaping for the server-mode spec (backslash then quote).
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

status=0

if [ -n "$server" ]; then
    export PROMPT_NVIM_SERVER="$server"

    # Neovim has no --remote-wait (E5600), so we drive the server over
    # --remote-expr: open the prompt in it, then poll until the user closes the
    # buffer. Session metadata goes through a temp JSON file rather than an
    # inline --remote-expr literal so target/path characters never have to
    # survive shell -> VimL -> Lua escaping; the server reads and decodes it.
    if [ -z "$backup_dir" ]; then
        printf '%s\n' "prompt-nvim: cannot create a temp dir for --server mode" >&2
        exit 1
    fi

    bridge_bool=false
    [ "$bridge" = "1" ] && bridge_bool=true
    spec_file="$backup_dir/spec.json"
    printf '{"file":"%s","target":"%s","cwd":"%s","session_id":"%s","bridge":%s,"backup":"%s"}\n' \
        "$(json_escape "$abs_file")" \
        "$(json_escape "$target")" \
        "$(json_escape "$launch_cwd")" \
        "$(json_escape "$session_id")" \
        "$bridge_bool" \
        "$(json_escape "$backup")" >"$spec_file"

    opened=$("$nvim_cmd" --server "$server" \
        --remote-expr "luaeval('require(\"prompt.remote\").open_from_file(_A)', '$spec_file')" 2>/dev/null || echo 0)
    case "$opened" in
        *1*) ;;
        *)
            printf '%s\n' "prompt-nvim: server did not open the prompt (is prompt.nvim loaded there?)" >&2
            cleanup
            exit 1
            ;;
    esac

    # Poll until the session buffer closes (return/cancel). A missing/dead
    # server yields empty output -> treated as closed, so we never hang forever.
    while :; do
        open=$("$nvim_cmd" --server "$server" \
            --remote-expr "luaeval('require(\"prompt.remote\").is_open(_A)', '$session_id')" 2>/dev/null || echo 0)
        case "$open" in
            *1*) sleep 0.2 ;;
            *) break ;;
        esac
    done

    cleanup
    exit 0
fi

# Fresh process. Not exec'd, so we can restore the backup on a crash and clean
# up. Normal cancel is byte-restored in-plugin; this is the crash safety net.
"$nvim_cmd" "$@" || status=$?
if [ "$status" -gt 128 ] && [ -n "$backup" ] && [ -f "$backup" ]; then
    cp -- "$backup" "$abs_file" 2>/dev/null || true
fi
cleanup
exit "$status"
